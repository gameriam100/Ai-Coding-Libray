.top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px;height:2.5em;min-height:2.5em}
.top h2{flex:0 0 auto;white-space:nowrap}
.top .tag{flex:1 1 auto;min-width:0;height:2.5em;line-height:2.5em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
h2{margin:0;font-size:18px;font-weight:700}
.tag{color:var(--dim);font-size:16px;text-align:right}
canvas{display:block;width:100%;height:92px;background:var(--well);border:2px solid var(--line);image-rendering:pixelated;margin-bottom:12px}
.row{display:flex;gap:10px;margin-bottom:16px}
