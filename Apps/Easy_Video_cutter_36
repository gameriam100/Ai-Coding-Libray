<script id="v35-google-sites-fullscreen">(()=>{
  const button=document.getElementById('bfullscreen');
  if(!button)return;
  let noticeTimer=0;
  const isFullscreen=()=>!!(document.fullscreenElement||document.webkitFullscreenElement);
  const isEmbedded=()=>{
    try{
      return window.self!==window.top
    }
    catch(e){
      return true
    }
  };
  function syncButton(){
    const active=isFullscreen();
    const embedded=isEmbedded();
    button.textContent=active?'⛶ Exit Fullscreen':(embedded?'↗ Open Fullscreen':'⛶ Fullscreen');
    button.title=active?'Exit fullscreen mode (Esc)':(embedded?'Open this editor in a new tab for fullscreen in Google Sites':'Enter fullscreen mode');
    button.setAttribute('aria-label',button.title);
    button.setAttribute('aria-pressed',String(active));
  }
  function showNotice(message,linkURL=''){
    let note=document.getElementById('fullscreenEmbedNotice');
    if(!note){
      note=document.createElement('div');note.id='fullscreenEmbedNotice';note.setAttribute('role','status');note.setAttribute('aria-live','polite');document.body.appendChild(note)
    }
    note.replaceChildren(document.createTextNode(message));
    if(linkURL){
      const link=document.createElement('a');link.href=linkURL;link.target='_blank';link.rel='noopener';link.textContent='Open editor';
      note.appendChild(link);
    }
    note.hidden=false;
    window.clearTimeout(noticeTimer);
    noticeTimer=window.setTimeout(()=>{
      note.hidden=true
    },10000);
  }
  function openStandalone(){
    const url=window.location.href;
    if(!/^https?:/i.test(url)){
      showNotice('For Google Sites, first host this HTML at an HTTPS web address, then embed that URL.');
      return;
    }
    // Commit the latest timeline snapshot before opening a second tab.
    try{
      if(typeof window.persist==='function')window.persist(true)
    }
    catch(e){
    }
    // Open synchronously during the user's click so browser popup protections see a user gesture.
    let opened=null;
    try{
      opened=window.open(url,'_blank');
    }
    catch(e){
    }
    if(opened){
      try{
        opened.opener=null
      }
      catch(e){
      }
      showNotice('The editor opened in a new tab. Use its Fullscreen button there.');
    }
    else{
      showNotice('Google Sites blocked opening a new tab. Open the hosted editor URL directly instead.',url);
    }
  }
  button.addEventListener('click',()=>{
    if(isFullscreen()){
      const exit=document.exitFullscreen||document.webkitExitFullscreen;
      if(!exit){
        showNotice('Your browser cannot exit fullscreen from this control. Press Esc to exit.');return
      }
      try{
        Promise.resolve(exit.call(document)).catch(()=>showNotice('Could not exit fullscreen. Press Esc to exit.'))
      }
      catch(e){
        showNotice('Could not exit fullscreen. Press Esc to exit.')
      }
      return;
    }
    // Google Sites controls the permissions of its outer iframe. The embedded page
    // cannot grant itself fullscreen, so launch the hosted editor outside that frame.
    if(isEmbedded()){
      openStandalone();
      return;
    }
    const target=document.documentElement;
    const request=target.requestFullscreen||target.webkitRequestFullscreen;
    if(!request){
      showNotice('Fullscreen is not supported by this browser.');return
    }
    try{
      Promise.resolve(request.call(target)).then(syncButton).catch(()=>showNotice('Fullscreen was blocked by the browser. Try maximizing the browser window.'));
    }
    catch(e){
      showNotice('Fullscreen could not start. Try maximizing the browser window.')
    }
  });
  document.addEventListener('fullscreenchange',syncButton);
  document.addEventListener('webkitfullscreenchange',syncButton);
  document.addEventListener('fullscreenerror',()=>showNotice('Fullscreen could not start. Check the page permissions.'));
  document.addEventListener('webkitfullscreenerror',()=>showNotice('Fullscreen could not start. Check the page permissions.'));
  document.addEventListener('keydown',e=>{
    if(e.key==='Escape')setTimeout(syncButton,0)
  });
  syncButton();
