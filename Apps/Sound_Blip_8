function musicSettings(){
  return{seed:baseOf('mseed'),style:v('style'),mlen:v('mlen'),voices:v('voices'),sect:v('sect'),tempo:v('tempo'),mpitch:v('mpitch'),key:v('key'),scale:v('scale'),lead:v('lead')};
}
function acceptMusic(data,gen,settings){
  if(gen!==mGen)return;
  mPendingRender=false;mData=data;mDataTempo=Number(settings.tempo)||120;
  draw($('#mw'),mData);msize();
