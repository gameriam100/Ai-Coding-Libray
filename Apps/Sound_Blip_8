  const t=(bar,s)=>{const q=bar*16+s,i=Math.floor(q),a=Tq(i),w=Tq(i+1)-a;return a+(q-i)*w+(i&1)*sw*w};
  let kf=440*2**((48+key+pit-69)/12);while(kf>90)kf/=2;while(kf<45)kf*=2;
  const hh=1;
  const densMul=1;
  const len=Math.round(tot*MS),X={m:new Float32Array(len),d:new Float32Array(len),kk:[],st:ST,n,s:seed,t,cad,kf,hh,lastBar:bars-1,
    deg:d=>sc[(d%n+n)%n]+12*Math.floor(d/n),mf:x=>{while(x<LO)x+=12;while(x>HI)x-=12;return 440*2**((x-69)/12)},root:48+key+pit,
    rec:Math.min(.14,60/bpm*.3)*MS|0,ts:Math.min(1,Math.max(.6,sd*8)),
    pd:rx=>rx()<pv*.45?pick(rx,[-2,2,n,-n,2,-2]):0,
    dur:(bar,s,l)=>t(bar,s+l)-t(bar,s)};
  const Z={sd:seed,cnt:{},nvc,dens:ST.dn*densMul,lw:LW[li],
    busy:.75+R('b')()*.55,
    hc:Math.max(5,Math.min(16,Math.round(8+ST.dn*8))),
    pal:pick(R('c'),PAL),st:ST};
  const secs=makeForm(R,bars,v('sect'),A),lay=Array.from({length:nvc},(_,i)=>makeLayer(i,Z));
