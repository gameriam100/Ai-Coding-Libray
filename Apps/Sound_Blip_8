const mDice=link('mseed',['style','mlen','voices','sect','tempo','mpitch','key','scale','lead'],['0','30','16','6','120','0','0','0','2'],musGo,false,{norm:seedNum,rnd:newSeed,roll:mRoll,liveDelay:180});
