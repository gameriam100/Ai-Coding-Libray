  const A=[...Array(n).keys()].filter(d=>n<7||([3,4].includes(sc[(d+2)%n]+(d+2>=n)*12-sc[d])&&sc[(d+4)%n]+(d+4>=n)*12-sc[d]==7)),cad=[4,3,5,0].find(d=>A.includes(d%n));
