<script id="v44-independent-track-focus">
(()=>{
 const content=document.getElementById('content');if(!content)return;
 let focusedTrack=window.__activeTimelineTrack||'V1';
 const setTrack=id=>{
   if(!id)return;focusedTrack=id;window.__activeTimelineTrack=id;
   content.querySelectorAll('.row').forEach(row=>{
     const lane=row.querySelector('.lane');
     const active=lane?.dataset.tr===id;
     row.classList.toggle('track-focused',active);
     const head=row.querySelector('.hd');
     if(head){head.setAttribute('aria-pressed',String(active));head.setAttribute('role','button');head.setAttribute('tabindex','0');head.title=`Select ${id==='FX'?'effects':id==='V1'?'video':id} track for playhead scrubbing and editing`;}
   });
   content.dataset.focusTrack=id;
 };
 const selectAtPlayhead=()=>{
   if(typeof sels==='undefined'||typeof S==='undefined')return;
   const active=S.clips.filter(c=>c.tr===focusedTrack&&(focusedTrack==='FX'?c.kind==='effect':c.kind!=='effect')&&S.t>=c.s-1e-7&&S.t<c.s+c.d-1e-7).sort((a,b)=>a.s-b.s).at(-1)||null;
   sels.clear();if(active)sels.add(active.id);
   content.querySelectorAll('.clip.sel').forEach(el=>el.classList.remove('sel'));
   if(active)content.querySelector(`.clip[data-id="${active.id}"]`)?.classList.add('sel');
   if(typeof renderEditorPanels==='function')renderEditorPanels();
 };
 content.addEventListener('click',e=>{
   const head=e.target.closest('.row:not(.ruler) .hd');if(!head)return;
   const lane=head.closest('.row')?.querySelector('.lane');if(!lane)return;
   setTrack(lane.dataset.tr);selectAtPlayhead();
 });
 content.addEventListener('keydown',e=>{
   const head=e.target.closest('.row:not(.ruler) .hd');if(!head||!['Enter',' '].includes(e.key))return;
   e.preventDefault();head.click();
 });
 // A playhead drag that starts on its ruler/grip retains the explicitly
 // selected track; a drag begun inside a lane targets that lane directly.
 document.addEventListener('pointerdown',e=>{
   const lane=e.target.closest('#content .lane');if(lane)setTrack(lane.dataset.tr);
 },true);
 document.addEventListener('pointermove',e=>{
   if(typeof scrub!=='undefined'&&scrub){
     const lane=[...content.querySelectorAll('.lane')].find(l=>{const r=l.getBoundingClientRect();return e.clientY>=r.top&&e.clientY<=r.bottom;});
     if(lane)setTrack(lane.dataset.tr);
   }
 },true);
 setTrack(focusedTrack);
 new MutationObserver(()=>setTrack(focusedTrack)).observe(content,{childList:true,subtree:true});
})();
</script>
