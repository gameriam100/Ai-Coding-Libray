<body>
<main>
<header>
  <h1>Seed<b>blip</b></h1>
  <p>Make pixel sound effects and music loops from a seed. Every setting is stored inside the seed, so pasting a seed brings back exactly that sound.</p>
</header>
<div class="grid">
  <section id="sfx">
    <div class="top"><h2>Blip maker</h2><span class="tag" id="sinfo"></span></div>
    <canvas id="sw" width="128" height="32"></canvas>
    <div class="row"><button id="splay" class="play">Play</button><button id="sdice">Random</button></div>
    <div class="seedbox"><span>Seed</span><input type="text" id="sseed" value="coin7" spellcheck="false" autocomplete="off" aria-label="Sound seed"></div>
    <div class="ctl" id="sctl"></div>
    <button id="ssave" class="dl">Download WAV</button>
  </section>
  <section id="mus">
    <div class="top"><h2>Loop maker</h2><span class="tag" id="minfo"></span></div>
    <canvas id="mw" width="128" height="32"></canvas>
    <div class="row"><button id="mplay" class="play">Play loop</button><button id="mdice">Random</button></div>
    <div class="seedbox"><span>Seed</span><input type="text" id="mseed" value="4829175306184" spellcheck="false" autocomplete="off" aria-label="Music seed"></div>
    <div class="ctl" id="mctl"></div>
    <button id="msave" class="dl">Download WAV</button>
  </section>
</div>
<footer style="margin-top:32px;padding-top:16px;border-top:2px solid var(--line);color:var(--dim);font-size:15px;text-align:center">Copyright free music that cannot be claimed, free to use commercially.</footer>
</main>
<script>
const $=s=>document.querySelector(s), v=id=>+$('#'+id).value;
const pick=(r,a)=>a[r()*a.length|0];
const hash=s=>{let h=1779033703^s.length;for(let i=0;i<s.length;i++){h=Math.imul(h^s.charCodeAt(i),3432918353);h=h<<13|h>>>19}
  h=Math.imul(h^h>>>16,2246822507);h=Math.imul(h^h>>>13,3266489909);return(h^h>>>16)>>>0};
const rngOf=s=>{let a=hash(String(s));return()=>{a=a+1831565813|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}};
const rand=()=>Math.random().toString(36).slice(2,7);
const kb=b=>b<10240?(b/1024).toFixed(1)+' KB':b<1048576?Math.round(b/1024)+' KB':(b/1048576).toFixed(2)+' MB';
const baseOf=id=>$('#'+id).value.split('~')[0].trim()||'x';

/* ---------- UI helpers ---------- */
const FM={};
function refresh(id){
  const i=$('#'+id);if(!i)return;
  if(FM[id])$('#'+id+'o').textContent=FM[id](+i.value);
  const sg=document.querySelector(`.seg[data-for="${id}"]`);
  if(sg)[...sg.children].forEach(b=>b.classList.toggle('on',b.dataset.v==i.value));
}
function build(el,defs){
  el.innerHTML=defs.map(d=>d.g
    ?`<div class="f w"><div class="lb"><span>${d.l}</span></div><div class="seg" data-for="${d.id}">${d.g.map((o,i)=>`<button type="button" data-v="${i}">${o}</button>`).join('')}</div><input type="hidden" id="${d.id}" value="${d.v||0}"></div>`
    :d.o
    ?`<div class="f"><div class="lb"><span>${d.l}</span></div><select id="${d.id}">${d.o.map((o,i)=>`<option value="${i}">${o}</option>`).join('')}</select></div>`
    :`<div class="f"><div class="lb"><span>${d.l}</span><output id="${d.id}o"></output></div><input type="range" id="${d.id}" min="${d.a}" max="${d.b}" step="${d.s||1}" value="${d.v}"></div>`).join('');
  defs.forEach(d=>{if(d.f)FM[d.id]=d.f;refresh(d.id)});
  el.addEventListener('input',e=>refresh(e.target.id));
  el.addEventListener('click',e=>{
    const b=e.target.closest('.seg button');if(!b)return;
    const i=$('#'+b.parentNode.dataset.for);i.value=b.dataset.v;refresh(i.id);
    ['input','change'].forEach(t=>i.dispatchEvent(new Event(t,{bubbles:true})));
  });
}
// Keeps seed text and controls in sync: "name~setting.setting.setting"
function link(seedId,ids,defs,run,live,o={}){
  const el=$('#'+seedId),ctl=el.closest('section').querySelector('.ctl');
  const enc=()=>ids.map(i=>$('#'+i).value).join('.');
  const write=()=>el.value=baseOf(seedId)+'~'+enc();
  let runTimer=0;
  ctl.addEventListener('input',e=>{
    if(!ids.includes(e.target.id))return;
    write();
    if(live)run();
    else if(o.liveDelay){clearTimeout(runTimer);runTimer=setTimeout(()=>{runTimer=0;run()},o.liveDelay)}
  });
  ctl.addEventListener('change',e=>{
    if(!live&&ids.includes(e.target.id)){
      if(runTimer){clearTimeout(runTimer);runTimer=0}
      run();
    }
  });
  el.addEventListener('change',()=>{
    if(runTimer){clearTimeout(runTimer);runTimer=0}
    const sp=el.value.split('~'),p=(sp[1]||'').split('.'),bare=o.roll&&sp.length<2,keep=!o.roll&&o.norm&&sp.length<2;
    if(o.norm)el.value=o.norm(sp[0]);
    if(bare)o.roll(el.value);
    else if(!keep)ids.forEach((id,i)=>{const x=$('#'+id);x.value=p[i]??defs[i];if(x.value==='')x.value=defs[i];refresh(id)});
    write();run(true);
  });
  if(o.roll)o.roll(baseOf(seedId));
  write();
  return()=>{if(runTimer){clearTimeout(runTimer);runTimer=0}const b=(o.rnd||rand)();if(o.roll)o.roll(b);el.value=b+'~'+enc();run(true)};
}
function draw(cv,d){
  const c=cv.getContext('2d'),W=cv.width,H=cv.height,k=Math.ceil(d.length/W);
  c.clearRect(0,0,W,H);c.fillStyle=getComputedStyle(cv.closest('section')).getPropertyValue('--c')||'#53d8fb';
  for(let x=0;x<W;x++){let p=0;for(let i=x*k,e=Math.min(d.length,i+k);i<e;i++){const a=Math.abs(d[i]);if(a>p)p=a}
    const h=Math.round(Math.min(1,p)*H/2);c.fillRect(x,H/2-h,1,Math.max(1,h*2))}
}
let ac;
function play(d,sr,loop,vol){
  ac=ac||new (window.AudioContext||window.webkitAudioContext)();ac.resume();
  const b=ac.createBuffer(1,d.length,sr);b.copyToChannel(d,0);
  const s=ac.createBufferSource(),g=ac.createGain();
  s.buffer=b;s.loop=!!loop;
  // short fade-in so start never clicks; full level quickly
  const t0=ac.currentTime;
  g.gain.setValueAtTime(0,t0);
  g.gain.linearRampToValueAtTime(vol,t0+.012);
  s.connect(g).connect(ac.destination);s.start(t0);
  return{s,g,vol};
}
function stopSrc(src){
  if(!src)return;
  try{
    const g=src.g,s=src.s,acx=ac;
    if(g&&acx){
      const t=acx.currentTime;
      g.gain.cancelScheduledValues(t);
      g.gain.setValueAtTime(g.gain.value,t);
      g.gain.linearRampToValueAtTime(0,t+.04);
      s.stop(t+.045);
    }else s.stop();
  }catch(e){}
}
function resample(d,from,to){
  if(from==to)return d;
  const r=from/to,n=Math.floor(d.length/r),o=new Float32Array(n);
  for(let i=0;i<n;i++){const a=Math.floor(i*r),e=Math.max(a+1,Math.floor((i+1)*r));let s=0;for(let j=a;j<e;j++)s+=d[j];o[i]=s/(e-a)}
  return o;
}
function wav(d,sr,bits){
  const n=d.length,by=bits/8,b=new DataView(new ArrayBuffer(44+n*by)),w=(o,s)=>[...s].forEach((c,i)=>b.setUint8(o+i,c.charCodeAt()));
  w(0,'RIFF');b.setUint32(4,36+n*by,true);w(8,'WAVEfmt ');b.setUint32(16,16,true);b.setUint16(20,1,true);b.setUint16(22,1,true);
  b.setUint32(24,sr,true);b.setUint32(28,sr*by,true);b.setUint16(32,by,true);b.setUint16(34,bits,true);w(36,'data');b.setUint32(40,n*by,true);
  for(let i=0;i<n;i++){const x=Math.max(-1,Math.min(1,d[i]));bits==8?b.setUint8(44+i,Math.round(x*127+128)):b.setInt16(44+i*2,x*32767,true)}
  return new Blob([b],{type:'audio/wav'});
}
function save(d,sr,bits,name){const a=document.createElement('a');a.href=URL.createObjectURL(wav(resample(d,sr[0],sr[1]),sr[1],bits));a.download=name.replace(/[^\w-]+/g,'_')+'.wav';a.click()}
// 0 square, 1 saw, 2 triangle, 3 sine, 4 noise
const W=(w,p,d,n)=>w==0?(p<d?1:-1):w==1?2*p-1:w==2?4*Math.abs(p-.5)-1:w==3?Math.sin(6.2832*p):n;
const sgn=x=>(x>0?'+':'')+x;

/* ---------- Blip maker: sfxr-style synth, 4x oversampled, saved as tiny 8-bit WAV ---------- */
const SR=22050,OS=4,NAMES=['Coin','Jump','Laser','Explosion','Power-up','Hit','Blip','Zap','Pickup','Alarm'];
const SQ=[[11025,8],[22050,8]];
build($('#sctl'),[
  {id:'wave',l:'Waveform',g:['Auto','Square','Saw','Tri','Sine','Noise']},
  {id:'pitch',l:'Pitch',a:-24,b:24,v:0,f:x=>sgn(x)+' st'},
  {id:'pvar',l:'Pitch variation',a:0,b:100,v:0,f:x=>x+'%'},
  {id:'len',l:'Duration',a:.3,b:3,s:.05,v:1,f:x=>x.toFixed(2)+'x'},
  {id:'punch',l:'Punch',a:0,b:100,v:30,f:x=>x+'%'},
  {id:'slide',l:'Sweep',a:-2,b:2,s:.1,v:0,f:x=>sgn(x.toFixed(1))},
  {id:'wob',l:'Wobble',a:0,b:100,v:0,f:x=>x+'%'},
  {id:'rep',l:'Retrigger',a:0,b:8,v:0,f:x=>x?x+'x':'off'},
  {id:'lpf',l:'Low-pass',a:10,b:100,v:100,f:x=>x+'%'},
  {id:'hpf',l:'High-pass',a:0,b:90,v:0,f:x=>x+'%'},
  {id:'crunch',l:'Bit crush',a:0,b:6,v:0},
  {id:'svol',l:'Volume',a:.1,b:1,s:.05,v:.6,f:x=>Math.round(x*100)+'%'},
  {id:'sq',l:'Download size',g:['Tiny 8-bit 11k','Small 8-bit 22k']}
]);
let sfxData,sfxSrc;
function sfx(){
  const base=baseOf('sseed'),r=rngOf('s'+base),R=(a,b)=>a+r()*(b-a),semi=n=>2**(n/12),pk=a=>pick(r,a);
  const t=r()*10|0;
  const p=Object.assign({w:0,f:440,fmin:0,sl:0,vd:0,vs:14,at:0,af:1,an:0,alt:0,du:.5,ds:0,a:.002,s:.08,dc:.2,lp:1,hp:0},[
    {f:R(900,1500),at:R(.04,.08),af:semi(pk([5,7,12])),an:1,s:R(.05,.1),dc:R(.15,.3)},
    {f:R(180,340),sl:R(1,2.2),s:R(.06,.14),dc:R(.1,.2),du:R(.3,.5)},
    {w:pk([0,1]),f:R(1200,2600),sl:-R(3,6),fmin:120,du:R(.1,.4),ds:-R(0,.5),s:R(.03,.1),dc:R(.1,.2)},
    {w:4,f:R(500,1500),sl:-R(.5,2),s:R(.1,.35),dc:R(.4,.9),lp:R(.25,.5)},
    {w:pk([0,1]),f:R(220,420),sl:R(.5,1.5),vd:.03,vs:15,at:R(.05,.08),af:semi(pk([3,4,5,7])),an:2+(r()*4|0),s:R(.15,.3),dc:R(.2,.4),du:pk([.25,.5])},
    {w:4,f:R(400,1000),sl:-R(2,5),s:R(.02,.05),dc:R(.1,.18),lp:R(.5,.9)},
    {w:pk([0,2]),f:R(500,1800),s:R(.03,.08),dc:R(.03,.08)},
    {w:1,f:R(600,1500),sl:-R(2,5),vd:R(.1,.25),vs:R(25,45),s:R(.04,.1),dc:R(.12,.25),hp:.1},
    {f:R(500,900),sl:R(2,4),ds:R(.3,.6),du:.15,s:R(.05,.12),dc:R(.1,.2),at:R(.05,.08),af:semi(pk([4,7])),an:1},
    {f:R(400,800),at:R(.08,.12),af:semi(pk([5,7,12])),an:99,alt:1,s:R(.4,.8),dc:.1}
  ][t]);
  const L=v('len'),pv=v('pvar')/100,wo=v('wave'),wb=v('wob')/100,sh=2**(v('pitch')/12);
  p.f*=sh;p.fmin*=sh;p.s*=L;p.dc*=L;p.at*=L;p.sl=p.sl/L+v('slide')*1.5;
  p.vd+=wb*.25;if(wb&&!p.vs)p.vs=14;if(wb)p.vs=Math.max(p.vs,8+wb*24);if(wo)p.w=wo-1;
  const punch=v('punch')/100,rep=v('rep'),lp=Math.min(p.lp,v('lpf')/100),hp=Math.max(p.hp,v('hpf')/100);
  const T=p.a+p.s+p.dc,repT=rep?T/(rep+1):0,N=Math.max(100,T*SR|0),o=new Float32Array(N);
  const rn=rngOf('n'+base),rj=rngOf('v'+base),lc=Math.max(.004,lp*lp*lp),hc=hp*hp*.05,jn=Math.round(.035*SR);
  let ph=0,nv=0,l1=0,l2=0,hz=0,jit=1,end=N;
  for(let i=0;i<N;i++){
    const tt=i/SR,tr=repT?tt%repT:tt;
    if(i%jn==0&&pv)jit=2**(Math.round((rj()*2-1)*pv*12)/12);
    const st=p.at?Math.min(Math.floor(tr/p.at),p.an):0,m=p.alt?(st%2?p.af:1):p.af**st;
    const fr=p.f*2**(p.sl*tr)*m*jit*(1+p.vd*Math.sin(6.2832*p.vs*tt));
    if(p.fmin&&fr<p.fmin){end=i;break}
    const inc=Math.min(Math.max(fr,80),4000)/(SR*OS),d=Math.min(.9,Math.max(.1,p.du+p.ds*tt));
    let x=0;
    for(let k=0;k<OS;k++){ph+=inc;if(ph>=1){ph-=1;nv=rn()*2-1}x+=W(p.w,ph,d,nv)}
    x/=OS;
    const e=tt<p.a?tt/p.a:tt<p.a+p.s?1+(1-(tt-p.a)/p.s)*2*punch:Math.max(0,1-(tt-p.a-p.s)/p.dc)**1.5;
    x*=e;
    l1+=lc*(x-l1);l2+=lc*(l1-l2);hz+=hc*(l2-hz);
    o[i]=l2-hz;
  }
  let pkv=0;const out=o.slice(0,end);
  for(let i=0;i<end;i++)pkv=Math.max(pkv,Math.abs(out[i]));
  const g=pkv?v('svol')/pkv:0,c=v('crunch');
  for(let i=0;i<end;i++)out[i]*=g;
  if(c){const k=1+c,q=2**(7-c);let h=0;for(let i=0;i<end;i++){if(i%k==0)h=Math.round(out[i]*q)/q;out[i]=h}}
  sfxData=out;draw($('#sw'),out);
  $('#sinfo').textContent=`${NAMES[t]}, ${(end/SR).toFixed(2)} s`;
  ssize();
}
function ssize(){if(!sfxData)return;const[sr,bits]=SQ[v('sq')];$('#ssave').textContent=`Download WAV, ${kb(44+Math.floor(sfxData.length*sr/SR)*bits/8)}`}
const sfxPlay=()=>{try{sfxSrc&&sfxSrc.s.stop()}catch(e){}sfxSrc=play(sfxData,SR,false,1)};
const sfxGo=(go=true)=>{sfx();if(go)sfxPlay()};
const sDice=link('sseed',['wave','pitch','pvar','len','punch','slide','wob','rep','lpf','hpf','crunch'],['0','0','0','1','30','0','0','0','100','0','0'],sfxGo,true);
$('#sctl').addEventListener('input',e=>{if(e.target.id=='svol')sfxGo()});
$('#sctl').addEventListener('change',e=>{if(e.target.id=='sq')ssize()});
$('#sdice').onclick=sDice;
$('#splay').onclick=()=>sfxGo();
$('#ssave').onclick=()=>save(sfxData,[SR,SQ[v('sq')][0]],8,'seedblip-sfx-'+baseOf('sseed'));

/* ---------- Loop maker: 32 kHz mono, numeric seed, sectioned song form, seeded layers, notes wrap so the loop is seamless ---------- */
const MS=32000,LO=40,HI=84,WC=[1,1.3,1.6,1.6,1];
const SCALES={Minor:[0,2,3,5,7,8,10],Major:[0,2,4,5,7,9,11],Dorian:[0,2,3,5,7,9,10],Phrygian:[0,1,3,5,7,8,10],Pentatonic:[0,2,4,7,9],'Minor pentatonic':[0,3,5,7,10],'Harmonic minor':[0,2,3,5,7,8,11],Mixolydian:[0,2,4,5,7,9,10],Lydian:[0,2,4,6,7,9,11]};
const SN=Object.keys(SCALES),KEYS=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const PROGS=[[0,5,3,4],[0,3,4,3],[0,4,5,3],[0,3,5,4],[5,3,0,4],[0,0,3,3,5,5,4,4],[5,4,3,4,5,4,0,0],[0,3,0,4]];
const ENERGY=[.35,.6,1.05,.38,.9,.55],PT=[1,1,2,3,4,1];
