  return X.m;
}
let mData,mSrc,mGen=0,mWorker=null,mWorkerURL=null,mRenderTimer=0;
let mPlaying=false,mPendingRender=false,mDataTempo=120,mPlaybackTempo=120;
const mActiveSources=new Set();
function msize(){
  if(!mData)return;const[sr,bits]=QUAL[v('q')];
  $('#msave').textContent=`Download WAV, ${kb(44+Math.floor(mData.length*sr/MS)*bits/8)}`;
}
function makeMusicSource(data,startAt,fadeIn=.06){
  ac=ac||new (window.AudioContext||window.webkitAudioContext)();
  if(ac.state==='suspended')ac.resume();
  const b=ac.createBuffer(1,data.length,MS);b.copyToChannel(data,0);
  const s=ac.createBufferSource(),g=ac.createGain(),t=Math.max(ac.currentTime+.01,startAt??ac.currentTime);
  s.buffer=b;s.loop=true;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(v('mvol'),t+fadeIn);
  s.connect(g).connect(ac.destination);
  const src={s,g,vol:v('mvol'),startedAt:t};
  s.onended=()=>mActiveSources.delete(src);
  mActiveSources.add(src);s.start(t);return src;
}
function fadeMusicSource(src,at,duration=.08){
  if(!src||!ac)return;
  try{
    const t=Math.max(ac.currentTime,at);
    src.g.gain.cancelScheduledValues(t);
    src.g.gain.setValueAtTime(src.g.gain.value,t);
    src.g.gain.linearRampToValueAtTime(0,t+duration);
    src.s.stop(t+duration+.01);
  }catch(e){}
}
function mStop(){
  mPlaying=false;
  for(const src of [...mActiveSources])fadeMusicSource(src,ac?ac.currentTime:0,.035);
  mSrc=null;$('#mplay').textContent='Play loop';
}
function mStart(){
  if(mPendingRender){mPlaying=true;$('#mplay').textContent='Stop';return;}
  if(!mData||!mData.length)return;
  mPlaying=true;mPlaybackTempo=mDataTempo;
  mSrc=makeMusicSource(mData,ac?ac.currentTime+.02:.02,.035);
  $('#mplay').textContent='Stop';
}
function swapMusicPlayback(data,tempo){
  if(!mPlaying)return;
  const now=ac?ac.currentTime:0,old=mSrc;
  let at=now+.025;
  if(old&&old.startedAt<=now){
    const beat=60/Math.max(40,mPlaybackTempo),elapsed=now-old.startedAt;
    const nextBeat=old.startedAt+(Math.floor(elapsed/beat)+1)*beat;
    if(nextBeat<=now+.24)at=Math.max(at,nextBeat);
  }else if(old)at=Math.max(at,old.startedAt);
  const next=makeMusicSource(data,at,.085);
  for(const src of [...mActiveSources])if(src!==next)fadeMusicSource(src,at,.095);
  mSrc=next;mPlaybackTempo=tempo||120;
}
function makeMusicWorkerURL(){
  if(mWorkerURL)return mWorkerURL;
  const script=[...document.scripts].find(x=>x.textContent.includes('/* ---------- Loop maker:'));
  if(!script)throw new Error('Music source was not found');
  const source=script.textContent;
  const loopMarker=source.indexOf('/* ---------- Loop maker:');
  const coreStart=source.indexOf('const MS=32000',loopMarker);
  const coreEnd=source.indexOf("build($('#mctl'),[",coreStart);
  const synthStart=source.indexOf('let NR;',coreEnd);
  const synthEnd=source.indexOf('let mData,mSrc,mGen=0,mWorker=null',synthStart);
  if(coreStart<0||coreEnd<0||synthStart<0||synthEnd<0)throw new Error('Music worker source could not be prepared');
  const helpers=`
let settings={};
const pick=(r,a)=>a[r()*a.length|0];
const hash=s=>{let h=1779033703^s.length;for(let i=0;i<s.length;i++){h=Math.imul(h^s.charCodeAt(i),3432918353);h=h<<13|h>>>19}h=Math.imul(h^h>>>16,2246822507);h=Math.imul(h^h>>>13,3266489909);return(h^h>>>16)>>>0};
const W=(w,p,d,n)=>w==0?(p<d?1:-1):w==1?2*p-1:w==2?4*Math.abs(p-.5)-1:w==3?Math.sin(6.2832*p):n;
const v=id=>Number(settings[id]??0);
const baseOf=()=>settings.seed;
const $=()=>({set textContent(value){postMessage({type:'status',value})}});
`;
  const workerCode=helpers+'\n'+source.slice(coreStart,coreEnd)+'\n'+source.slice(synthStart,synthEnd)+`
self.onmessage=event=>{settings=event.data;try{const audio=music();postMessage({type:'done',buffer:audio.buffer},[audio.buffer])}catch(error){postMessage({type:'error',message:error&&error.message?error.message:String(error)})}};`;
