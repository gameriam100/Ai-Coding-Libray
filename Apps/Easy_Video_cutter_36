<script id="v40-playhead-release-click-guard">
(()=>{
  const content=document.getElementById('content');
  if(!content)return;
  let playheadGesture=null, suppressClick=null;
  const nearPlayhead=(e)=>{
    const pin=document.querySelector('#pin');
    const grip=document.querySelector('#pin i');
    const ph=document.querySelector('#ph');
    if(e.target?.closest?.('#pin i,#ph'))return true;
    const r=(grip&&grip.getBoundingClientRect().width?grip:pin||ph)?.getBoundingClientRect();
    if(!r||!Number.isFinite(r.left))return false;
    const x=r.left+(r.width/2);
    const scroll=document.getElementById('scroll')?.getBoundingClientRect();
    return Math.abs(e.clientX-x)<=17 && !!scroll && e.clientY>=scroll.top && e.clientY<=scroll.bottom;
  };
  document.addEventListener('pointerdown',e=>{
    if(e.button!==0)return;
    if(content.contains(e.target)&&nearPlayhead(e))playheadGesture={id:e.pointerId,x:e.clientX,y:e.clientY};
    else playheadGesture=null;
  },true);
  document.addEventListener('pointerup',e=>{
    if(!playheadGesture||playheadGesture.id!==e.pointerId)return;
    suppressClick={x:e.clientX,y:e.clientY,until:performance.now()+700};
    playheadGesture=null;
  },true);
  document.addEventListener('pointercancel',()=>{playheadGesture=null;suppressClick=null},true);
  document.addEventListener('click',e=>{
    if(!suppressClick)return;
    const s=suppressClick;
    if(performance.now()>s.until){suppressClick=null;return;}
    if(Math.hypot(e.clientX-s.x,e.clientY-s.y)<=30){
      e.preventDefault();e.stopPropagation();e.stopImmediatePropagation();suppressClick=null;
    }
  },true);
  // Remove browser text-selection artifacts after any timeline gesture.
  content.addEventListener('pointerdown',()=>{if(window.getSelection)window.getSelection().removeAllRanges()},true);
})();
</script>

<!-- v42: commit the exact pointer-up position before ending timeline scrubs -->
<script id="v42-fast-scrub-selection-commit">
(()=>{
  const content=document.getElementById('content');
  if(!content)return;

  // Pointer events can be coalesced during fast drags. Always process the
  // release coordinate as the final scrub sample before the normal handler
  // clears the scrub state.
  document.addEventListener('pointerup',e=>{
    if(typeof scrub!=='undefined'&&scrub){
      try{
        doScrub(e);
        if(typeof syncSelectionToPlayhead==='function')
          syncSelectionToPlayhead(S.t,typeof scrubTrackId==='string'?scrubTrackId:'V1');
        if(typeof refreshPropValues==='function')refreshPropValues();
      }catch(err){console.warn('Final timeline scrub sample failed',err)}
    }

    // Fullscreen navigation also batches seeks into animation frames. Flush
    // the release position synchronously so selection cannot lag one frame.
    try{
      if(typeof FS!=='undefined'&&FS.drag&&FS.drag.mode==='tl'&&typeof fsTimeAt==='function'){
        const t=fsTimeAt(e.clientX,!e.altKey);
        if(typeof fsSeek==='function')fsSeek(t);
        if(FS.raf){cancelAnimationFrame(FS.raf);FS.raf=0}
        if(FS.pend!=null){const finalTime=FS.pend;FS.pend=null;seek(finalTime)}
        if(typeof syncSelectionToPlayhead==='function')syncSelectionToPlayhead(S.t,'V1');
        if(typeof renderFullscreenNav==='function'){
          document.querySelectorAll('#notesTimeline .navClip').forEach(el=>el.classList.toggle('active',Number(el.dataset.noteClipId)===Number([...sels][0])));
        }
      }
    }catch(err){console.warn('Final fullscreen scrub sample failed',err)}
  },true);
})();
</script>

