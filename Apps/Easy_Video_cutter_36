<script id="v25-fullscreen-timeline-engine">(()=>{
  const root=$('#notesTimeline');if(!root)return;
  function formatRulerTime(t){
    return tc(t).slice(0,8)
  }
  function renderFullscreenNavV23(){
    if(!root||!$('#notesOverlay').classList.contains('open'))return;
    FS.total=Math.max(end(),.1);
    const head=document.createElement('div');head.className='fsNavHead';
    const title=document.createElement('span');title.className='fsNavTitle';title.textContent='TIMELINE';
    const time=document.createElement('span');time.className='fsTimeReadout';time.textContent=tc(S.t)+' / '+tc(FS.total);head.append(title,time);
    const track=document.createElement('div');track.className='navTrack';track.setAttribute('role','slider');track.setAttribute('aria-label','Fullscreen video timeline');track.setAttribute('aria-valuemin','0');track.setAttribute('aria-valuemax',String(FS.total));track.setAttribute('aria-valuenow',String(S.t));
    const rulerLabel=document.createElement('div');rulerLabel.className='fsRulerLabel';rulerLabel.textContent='TIME';
    const ruler=document.createElement('div');ruler.className='fsRuler';
    const pxPerSec=Math.max(1,root.clientWidth-55)/FS.total;
    const steps=[1,2,5,10,15,30,60,120,300,600,900,1800,3600,7200,14400];
    const tickStep=steps.find(s=>s*pxPerSec>=76)||14400;
    for(let t=0,guard=0;t<=FS.total+1e-6&&guard++<300;t+=tickStep){
      const tick=document.createElement('div');tick.className='fsRulerTick';tick.style.left=(t/FS.total*100)+'%';const label=document.createElement('b');label.textContent=formatRulerTime(t);tick.append(label);ruler.append(tick)
    }
    track.append(rulerLabel,ruler);
    const clipEdges=[0,FS.total];
    for(const tr of [TR.find(t=>t.id==='V1')||{id:'V1',t:'v'}]){
      const label=document.createElement('div');label.className='fsTrackLabel';label.dataset.track=tr.id;label.textContent=tr.id;track.append(label);
      const lane=document.createElement('div');lane.className='fsTrackLane';lane.dataset.tr=tr.id;
      const clips=S.clips.filter(c=>c.tr==='V1'&&c.kind!=='effect').sort((a,b)=>a.s-b.s);
      clips.forEach((c,i)=>{
        clipEdges.push(c.s,c.s+c.d);const prev=clips[i-1];
        if(prev&&Math.abs(prev.s+prev.d-c.s)<=1/FPS){
          const cut=document.createElement('i');cut.className='navCut';cut.style.left=(c.s/FS.total*100)+'%';lane.append(cut)
        }
        const card=document.createElement('div');card.className='navClip'+(c.id===notesTargetId?' active':'');
        card.dataset.noteClipId=String(c.id);card.style.left=(c.s/FS.total*100)+'%';card.style.width=(c.d/FS.total*100)+'%';card.style.background=c.c||'#5279a5';card.title=(c.n||tr.id)+' · '+tc(c.s)+'–'+tc(c.s+c.d);
        const name=document.createElement('span');name.className='navClipName';name.textContent=c.kind==='effect'?'✦ '+(c.n||'Effect'):(c.n||'Clip');card.append(name);lane.append(card);
      });
      track.append(lane);
    }
    root.replaceChildren(head,track);
    FS.edges=[...new Set(clipEdges.map(v=>Math.max(0,Math.min(FS.total,v))))].sort((a,b)=>a-b);
    fsPlayheadV23();
  }
  function fsPlayheadV23(){
    const track=fsTrack();if(!track)return;const readout=root.querySelector('.fsTimeReadout');if(readout)readout.textContent=tc(S.t)+' / '+tc(FS.total);
    track.setAttribute('aria-valuenow',String(S.t));
  }
  function fsTimeAtV23(x,snap){
    const ruler=fsTrack()?.querySelector('.fsRuler');if(!ruler)return 0;const r=ruler.getBoundingClientRect();
    const t=Math.max(0,Math.min(FS.total,(x-r.left)/Math.max(1,r.width)*FS.total));if(!snap)return t;
    let best=t,min=8/Math.max(1,r.width)*FS.total;for(const edge of FS.edges){
      const dist=Math.abs(edge-t);if(dist<min){
        min=dist;best=edge
      }
    }
    return best;
  }
  renderFullscreenNav=renderFullscreenNavV23;fsPlayhead=fsPlayheadV23;fsTimeAt=fsTimeAtV23;
  window.addEventListener('resize',()=>{
    if($('#notesOverlay').classList.contains('open'))renderFullscreenNavV23()
  },{
    passive:true
  });
})();
</script>



