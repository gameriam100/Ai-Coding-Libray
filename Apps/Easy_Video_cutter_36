<script id="v39-timeline-coordinate-fix">
(()=>{
  // Use the actual timeline lane bounds for both regular and fullscreen scrubbing.
  const root=document.getElementById('notesTimeline');
  if(!root)return;
  const oldRender=renderFullscreenNav;
  renderFullscreenNav=()=>{
    if(!root.classList || !document.getElementById('notesOverlay').classList.contains('open'))return;
    FS.total=Math.max(end(),.1);
    const track=document.createElement('div');
    track.className='navTrack';
    track.setAttribute('role','slider');
    track.setAttribute('aria-label','Fullscreen video timeline');
    track.setAttribute('aria-valuemin','0');
    track.setAttribute('aria-valuemax',String(FS.total));
    track.setAttribute('aria-valuenow',String(S.t));
    const lane=document.createElement('div');lane.className='fsTrackLane';lane.dataset.tr='V1';
    const clips=S.clips.filter(c=>c.tr==='V1'&&c.kind!=='effect').sort((a,b)=>a.s-b.s);
    const edges=[0,FS.total];
    clips.forEach(c=>{
      edges.push(c.s,c.s+c.d);
      const card=document.createElement('div');
      card.className='navClip'+(c.id===notesTargetId||sels.has(c.id)?' active':'');
      card.dataset.noteClipId=String(c.id);
      card.style.left=(Math.max(0,c.s)/FS.total*100)+'%';
      card.style.width=(Math.max(0,c.d)/FS.total*100)+'%';
      card.style.background=c.c||'#5279a5';
      card.title=(c.n||'Clip')+' · '+tc(c.s)+'–'+tc(c.s+c.d);
      const name=document.createElement('span');name.className='navClipName';name.textContent=c.n||'Clip';card.append(name);lane.append(card);
    });
    track.append(lane);root.replaceChildren(track);
    FS.edges=[...new Set(edges.map(v=>Math.max(0,Math.min(FS.total,v))))].sort((a,b)=>a-b);
    fsPlayhead();
  };
  fsTimeAt=(x,snap)=>{
    const lane=root.querySelector('.fsTrackLane')||root.querySelector('.navTrack');
    if(!lane)return 0;
    const r=lane.getBoundingClientRect();
    const t=Math.max(0,Math.min(FS.total,(x-r.left)/Math.max(1,r.width)*FS.total));
    if(!snap)return t;
    let best=t,min=8/Math.max(1,r.width)*FS.total;
    for(const edge of FS.edges){const d=Math.abs(edge-t);if(d<min){min=d;best=edge}}
    return best;
  };
  fsPlayhead=()=>{
    const track=root.querySelector('.navTrack'),lane=root.querySelector('.fsTrackLane');
    if(!track||!lane)return;
    let p=track.querySelector('.fsNavPlayhead');
    if(!p){p=document.createElement('i');p.className='fsNavPlayhead';track.append(p)}
    const laneWidth=Math.max(1,lane.offsetWidth);
    const x=Math.max(0,Math.min(laneWidth,(Math.max(0,Math.min(FS.total,S.t))/Math.max(FS.total,.1))*laneWidth));
    p.style.left=x+'px';p.style.top='0px';p.style.bottom='0';
    track.setAttribute('aria-valuenow',String(S.t));
  };
  const refresh=()=>{if(document.getElementById('notesOverlay').classList.contains('open'))fsPlayhead()};
  window.addEventListener('resize',refresh,{passive:true});
  new MutationObserver(refresh).observe(root,{childList:true,subtree:true});
})();
</script>

